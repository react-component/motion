{
  "compilerOptions": {
    "target": "esnext",
    "moduleResolution": "node",
    "baseUrl": "./",
    "jsx": "react",
    "declaration": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "paths": {
      "@/*": ["src/*"],
      "@@/*": [".dumi/tmp/*"],
      "@rc-component/motion": ["src/index.tsx"],
      "rc-motion": ["src/index.tsx"]
    }
  },
  "include": ["src", "docs", ".dumirc.ts", ".fatherrc.ts"],
  "exclude": ["node_modules", "lib", "es", "dist", "docs-dist"]
}
